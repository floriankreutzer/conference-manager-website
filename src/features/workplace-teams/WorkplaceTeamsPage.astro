---
import EditorialStory from '@components/editorial/EditorialStory.astro';
import BrandVisual from '@components/marketing/BrandVisual.astro';
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getPublicPageCopy } from '@i18n/publicPages';
import { getWorkplaceTeamsCopy } from '@i18n/workplaceTeams';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pageCopy = getPublicPageCopy(locale, 'workplace-teams');
const story = getWorkplaceTeamsCopy(locale);
const primaryHref = withBasePath(`/${locale}/how-it-works/`);
const secondaryHref = withBasePath(`/${locale}/security-trust/`);
---

<EditorialStory
  eyebrow={pageCopy.eyebrow}
  title={pageCopy.title}
  lead={pageCopy.body}
  sections={story.sections}
  closing={story.closing}
  primaryHref={primaryHref}
  secondaryHref={secondaryHref}
  idPrefix="workplace-teams"
  sectionIcons={['coordination', 'request', 'room-equipment', 'participants']}
>
  <BrandVisual slot="visual" locale={locale} variant="preparation" priority />
</EditorialStory>
