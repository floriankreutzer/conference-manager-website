---
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getPublicPageCopy } from '@i18n/publicPages';
import { getWorkplaceTeamsCopy } from '@i18n/workplaceTeams';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pageCopy = getPublicPageCopy(locale, 'workplace-teams');
const story = getWorkplaceTeamsCopy(locale);
const demoHref = withBasePath(`/${locale}/book-a-demo/`);
const productHref = withBasePath(`/${locale}/product/`);
---

<article class="workplace-teams">
  <header class="workplace-teams__hero" aria-labelledby="workplace-teams-title">
    <p class="eyebrow">{pageCopy.eyebrow}</p>
    <h1 id="workplace-teams-title">{pageCopy.title}</h1>
    <p class="workplace-teams__lead">{pageCopy.body}</p>
    <div class="workplace-teams__actions">
      <a class="button" href={demoHref}>{story.closing.primaryCta}</a>
      <a class="workplace-teams__text-link" href={productHref}
        >{story.closing.secondaryCta}<span aria-hidden="true"> →</span></a
      >
    </div>
  </header>

  <ol class="workplace-teams__sections">
    {
      story.sections.map((section, index) => {
        const headingId = `workplace-teams-section-${index + 1}`;
        return (
          <li>
            <section class="workplace-teams__section" aria-labelledby={headingId}>
              <div class="workplace-teams__section-heading">
                <p class="eyebrow">{section.eyebrow}</p>
                <h2 id={headingId}>{section.title}</h2>
              </div>
              <div class="workplace-teams__section-copy">
                <p>{section.body}</p>
                {section.points && (
                  <ul class="workplace-teams__points">
                    {section.points.map((point) => (
                      <li>
                        <h3>{point.title}</h3>
                        <p>{point.body}</p>
                      </li>
                    ))}
                  </ul>
                )}
                {section.statement && (
                  <p class="workplace-teams__statement">{section.statement}</p>
                )}
              </div>
            </section>
          </li>
        );
      })
    }
  </ol>

  <section class="workplace-teams__closing" aria-labelledby="workplace-teams-closing-title">
    <p class="eyebrow workplace-teams__closing-eyebrow">{story.closing.eyebrow}</p>
    <h2 id="workplace-teams-closing-title">{story.closing.title}</h2>
    <p>{story.closing.body}</p>
    <div class="workplace-teams__actions">
      <a class="button workplace-teams__button-light" href={demoHref}
        >{story.closing.primaryCta}</a
      >
      <a class="workplace-teams__text-link workplace-teams__text-link--light" href={productHref}
        >{story.closing.secondaryCta}<span aria-hidden="true"> →</span></a
      >
    </div>
  </section>
</article>

<style>
  .workplace-teams {
    padding-block: clamp(4rem, 9vw, 8rem);
    overflow-wrap: anywhere;
  }

  .workplace-teams__hero {
    display: grid;
    gap: var(--space-4);
    max-width: 64rem;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 9vw, 7rem);
  }

  .workplace-teams__hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 6rem);
    letter-spacing: -0.05em;
  }

  .workplace-teams__lead,
  .workplace-teams__section-copy > p,
  .workplace-teams__points p,
  .workplace-teams__closing > p {
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .workplace-teams__lead {
    margin: 0;
    font-size: clamp(1.08rem, 1.6vw, 1.35rem);
  }

  .workplace-teams__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .workplace-teams__text-link {
    font-weight: 700;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.25em;
  }

  .workplace-teams__sections {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-ink);
  }

  .workplace-teams__sections > li {
    border-bottom: 1px solid var(--color-border);
  }

  .workplace-teams__section {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .workplace-teams__section-heading {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .workplace-teams__section-heading h2 {
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .workplace-teams__section-copy {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .workplace-teams__section-copy > p {
    margin: 0;
    font-size: 1.05rem;
  }

  .workplace-teams__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .workplace-teams__points li {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .workplace-teams__points h3,
  .workplace-teams__points p {
    margin: 0;
  }

  .workplace-teams__points h3 {
    font-size: 1.1rem;
  }

  .workplace-teams__section-copy > .workplace-teams__statement {
    max-width: 28ch;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-camel);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.7vw, 2.25rem);
    font-weight: 650;
    line-height: 1.25;
  }

  .workplace-teams__closing {
    display: grid;
    gap: var(--space-4);
    margin-top: clamp(4rem, 9vw, 8rem);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-on-accent);
  }

  .workplace-teams__closing h2,
  .workplace-teams__closing > p {
    margin: 0;
  }

  .workplace-teams__closing > p {
    color: var(--color-on-dark-muted);
  }

  .workplace-teams__closing-eyebrow {
    color: var(--color-camel);
  }

  .workplace-teams__button-light {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .workplace-teams__button-light:hover {
    background: var(--color-canvas);
  }

  .workplace-teams__text-link--light {
    color: var(--color-on-accent);
  }

  @media (max-width: 52rem) {
    .workplace-teams__section {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 36rem) {
    .workplace-teams__points {
      grid-template-columns: 1fr;
    }

    .workplace-teams__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
