---
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getProductStoryCopy, type ProductStorySlug } from '@i18n/productStory';
import { getPublicPageCopy } from '@i18n/publicPages';

interface Props {
  locale: Locale;
  slug: ProductStorySlug;
}

const { locale, slug } = Astro.props;
const pageCopy = getPublicPageCopy(locale, slug);
const story = getProductStoryCopy(locale, slug);
const demoHref = withBasePath(`/${locale}/book-a-demo/`);
const secondaryHref = withBasePath(
  slug === 'product' ? `/${locale}/how-it-works/` : `/${locale}/product/`,
);
---

<article class="product-story">
  <header class="product-story__hero" aria-labelledby="product-story-title">
    <p class="eyebrow">{pageCopy.eyebrow}</p>
    <h1 id="product-story-title">{pageCopy.title}</h1>
    <p class="product-story__lead">{pageCopy.body}</p>
    <div class="product-story__actions">
      <a class="button" href={demoHref}>{story.closing.primaryCta}</a>
      <a class="product-story__text-link" href={secondaryHref}
        >{story.closing.secondaryCta}<span aria-hidden="true"> →</span></a
      >
    </div>
  </header>

  <ol class="product-story__sections">
    {
      story.sections.map((section, index) => {
        const headingId = `product-story-section-${index + 1}`;

        return (
          <li>
            <section class="product-story__section" aria-labelledby={headingId}>
              <div class="product-story__section-heading">
                <p class="eyebrow">{section.eyebrow}</p>
                <h2 id={headingId}>{section.title}</h2>
              </div>
              <div class="product-story__section-copy">
                <p>{section.body}</p>
                {section.points && (
                  <ul class="product-story__points">
                    {section.points.map((point) => (
                      <li>
                        <h3>{point.title}</h3>
                        <p>{point.body}</p>
                      </li>
                    ))}
                  </ul>
                )}
                {section.statement && <p class="product-story__statement">{section.statement}</p>}
              </div>
            </section>
          </li>
        );
      })
    }
  </ol>

  <section class="product-story__closing" aria-labelledby="product-story-closing-title">
    <p class="eyebrow product-story__closing-eyebrow">{story.closing.eyebrow}</p>
    <h2 id="product-story-closing-title">{story.closing.title}</h2>
    <p>{story.closing.body}</p>
    <div class="product-story__actions">
      <a class="button product-story__button-light" href={demoHref}>{story.closing.primaryCta}</a>
      <a class="product-story__text-link product-story__text-link--light" href={secondaryHref}
        >{story.closing.secondaryCta}<span aria-hidden="true"> →</span></a
      >
    </div>
  </section>
</article>

<style>
  .product-story {
    padding-block: clamp(4rem, 9vw, 8rem);
    overflow-wrap: anywhere;
  }

  .product-story__hero {
    display: grid;
    gap: var(--space-4);
    max-width: 64rem;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 9vw, 7rem);
  }

  .product-story__hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 6rem);
    letter-spacing: -0.05em;
  }

  .product-story__lead,
  .product-story__section-copy > p,
  .product-story__points p,
  .product-story__closing > p {
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .product-story__lead {
    margin: 0;
    font-size: clamp(1.08rem, 1.6vw, 1.35rem);
  }

  .product-story__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .product-story__text-link {
    font-weight: 700;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.25em;
  }

  .product-story__sections {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-ink);
  }

  .product-story__sections > li {
    border-bottom: 1px solid var(--color-border);
  }

  .product-story__section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .product-story__section-heading {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .product-story__section-heading h2 {
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .product-story__section-copy {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .product-story__section-copy > p {
    margin: 0;
    font-size: 1.05rem;
  }

  .product-story__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .product-story__points li {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .product-story__points h3,
  .product-story__points p {
    margin: 0;
  }

  .product-story__points h3 {
    font-size: 1.1rem;
  }

  .product-story__section-copy > .product-story__statement {
    max-width: 24ch;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-camel);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.7vw, 2.25rem);
    font-weight: 650;
    line-height: 1.25;
  }

  .product-story__closing {
    display: grid;
    gap: var(--space-4);
    margin-top: clamp(4rem, 9vw, 8rem);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-on-accent);
  }

  .product-story__closing h2,
  .product-story__closing > p {
    margin: 0;
  }

  .product-story__closing > p {
    color: var(--color-on-dark-muted);
  }

  .product-story__closing-eyebrow {
    color: var(--color-camel);
  }

  .product-story__button-light {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .product-story__button-light:hover {
    background: var(--color-canvas);
  }

  .product-story__text-link--light {
    color: var(--color-on-accent);
  }

  @media (max-width: 52rem) {
    .product-story__section {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 36rem) {
    .product-story__points {
      grid-template-columns: 1fr;
    }

    .product-story__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
