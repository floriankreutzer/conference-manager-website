---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import BrandVisual from '@components/marketing/BrandVisual.astro';
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getInsightsJourneyCopy } from '@i18n/insightsJourney';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'insights'>;
}

const { locale, entry } = Astro.props;
const { Content, headings } = await render(entry);
const labels = getInsightsJourneyCopy(locale);
const journey = labels.articleClosing;
const dateLocale = locale === 'de' ? 'de-DE' : 'en-GB';
const workflowHref = withBasePath(`/${locale}/how-it-works/`);
const integrationsHref = withBasePath(`/${locale}/integrations/`);
const contents = headings.filter((heading) => heading.depth === 2);
const formatDate = (date: Date) =>
  date.toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<article class="insight-article">
  <a class="text-link insight-article__back" href={withBasePath(`/${locale}/insights/`)}>
    <span aria-hidden="true">← </span>{labels.backLabel}
  </a>
  <header class="insight-article__header">
    <div class="insight-article__intro">
      <p class="eyebrow">{labels.articleEyebrow}</p>
      <h1>{entry.data.title}</h1>
      <p class="insight-article__description">{entry.data.description}</p>
      <div class="insight-article__dates">
        {
          entry.data.publishedAt && (
            <p>
              {labels.publishedLabel}{' '}
              <time datetime={entry.data.publishedAt.toISOString()}>
                {formatDate(entry.data.publishedAt)}
              </time>
            </p>
          )
        }
        {
          entry.data.updatedAt && (
            <p>
              {labels.updatedLabel}{' '}
              <time datetime={entry.data.updatedAt.toISOString()}>
                {formatDate(entry.data.updatedAt)}
              </time>
            </p>
          )
        }
      </div>
    </div>
    <div class="insight-article__visual">
      <BrandVisual locale={locale} variant="preparation" priority />
    </div>
  </header>

  <div class="insight-article__reading">
    {
      contents.length > 0 && (
        <nav class="insight-article__contents" aria-labelledby="insight-contents-title">
          <h2 id="insight-contents-title">{labels.contentsLabel}</h2>
          <ol>
            {contents.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="insight-article__body">
      <Content />
    </div>
  </div>

  <section class="insight-article__closing" aria-labelledby="insight-closing-title">
    <p class="eyebrow">{journey.eyebrow}</p>
    <h2 id="insight-closing-title">{journey.title}</h2>
    <p>{journey.body}</p>
    <div class="insight-article__actions">
      <a class="text-link" href={workflowHref}
        >{journey.primaryCta}<span aria-hidden="true"> →</span></a
      >
      <a class="text-link" href={integrationsHref}
        >{journey.secondaryCta}<span aria-hidden="true"> →</span></a
      >
    </div>
  </section>
</article>

<style>
  .insight-article {
    padding-block: clamp(3rem, 7vw, 6rem);
    overflow-wrap: anywhere;
  }

  .insight-article__back {
    display: inline-flex;
    width: fit-content;
    margin-bottom: var(--space-6);
  }

  .insight-article__header {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .insight-article__intro {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .insight-article__header h1 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.5rem, 4.7vw, 4.5rem);
    letter-spacing: -0.05em;
  }

  .insight-article__description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1.08rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .insight-article__dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .insight-article__dates p {
    margin: 0;
  }

  .insight-article__visual {
    min-width: 0;
  }

  .insight-article__contents h2 {
    max-width: none;
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .insight-article__reading {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    display: grid;
    align-items: start;
    gap: var(--space-6);
  }

  .insight-article__contents {
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
  }

  .insight-article__contents ol {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-4) 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-muted);
  }

  .insight-article__contents a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--color-bordeaux);
    font-size: 0.9rem;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.2em;
  }

  .insight-article__body {
    min-width: 0;
    max-width: 46rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .insight-article__body > :global(p:first-child) {
    margin-top: 0;
    color: var(--color-ink);
    font-size: 1.16rem;
  }

  .insight-article__body :global(h2) {
    max-width: 26ch;
    margin-top: 2.2em;
    scroll-margin-top: var(--space-5);
    font-size: clamp(1.65rem, 2.7vw, 2.35rem);
    line-height: 1.18;
  }

  .insight-article__body :global(h3) {
    margin-top: 2em;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }

  .insight-article__body :global(p),
  .insight-article__body :global(li) {
    color: var(--color-text-muted);
  }

  .insight-article__body :global(strong) {
    color: var(--color-ink);
  }

  .insight-article__body :global(li) {
    margin-block: var(--space-2);
  }

  .insight-article__body :global(a) {
    color: var(--color-bordeaux);
  }

  .insight-article__closing {
    display: grid;
    gap: var(--space-4);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-block-start: clamp(1.5rem, 4vw, 3rem);
    border-block-start: 1px solid var(--color-border);
  }

  .insight-article__closing h2,
  .insight-article__closing > p {
    margin: 0;
  }

  .insight-article__closing h2 {
    max-width: 30ch;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .insight-article__closing > p:not(.eyebrow) {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .insight-article__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  @media (min-width: 48rem) {
    .insight-article__header {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  @media (min-width: 62rem) {
    .insight-article__reading {
      grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.38fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }

    .insight-article__contents {
      position: sticky;
      top: var(--space-5);
      grid-column: 2;
      grid-row: 1;
    }

    .insight-article__body {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 36rem) {
    .insight-article__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
