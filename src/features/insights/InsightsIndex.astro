---
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getInsightsJourneyCopy } from '@i18n/insightsJourney';
import { getPublicPageCopy } from '@i18n/publicPages';
import { getPublishedInsightsForLocale } from './content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getPublicPageCopy(locale, 'insights');
const journey = getInsightsJourneyCopy(locale).indexClosing;
const entries = await getPublishedInsightsForLocale(locale);
const emptyText =
  locale === 'de'
    ? 'Noch keine veröffentlichten Insights. Inhalte erscheinen hier erst nach vollständiger fachlicher, Brand- und Übersetzungsfreigabe.'
    : 'No insights are published yet. Content appears here only after complete claim, brand and translation review.';
const dateLocale = locale === 'de' ? 'de-DE' : 'en-GB';
const demoHref = withBasePath(`/${locale}/book-a-demo/`);
const productHref = withBasePath(`/${locale}/product/`);
---

<section class="insights-index" aria-labelledby="insights-title">
  <header class="insights-index__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="insights-title">{copy.title}</h1>
    <p>{copy.description}</p>
  </header>

  {
    entries.length === 0 ? (
      <p class="insights-index__empty">{emptyText}</p>
    ) : (
      <ol class="insights-list">
        {entries.map((entry) => (
          <li>
            <article>
              <p class="insights-list__meta">
                <time datetime={entry.data.publishedAt?.toISOString()}>
                  {entry.data.publishedAt?.toLocaleDateString(dateLocale, {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </p>
              <h2>
                <a href={withBasePath(`/${locale}/insights/${entry.data.routeSlug}/`)}>
                  {entry.data.title}
                </a>
              </h2>
              <p>{entry.data.description}</p>
            </article>
          </li>
        ))}
      </ol>
    )
  }

  <section class="insights-index__closing" aria-labelledby="insights-closing-title">
    <p class="eyebrow">{journey.eyebrow}</p>
    <h2 id="insights-closing-title">{journey.title}</h2>
    <p>{journey.body}</p>
    <div class="insights-index__actions">
      <a class="button" href={demoHref}>{journey.primaryCta}</a>
      <a class="text-link" href={productHref}
        >{journey.secondaryCta}<span aria-hidden="true"> →</span></a
      >
    </div>
  </section>
</section>

<style>
  .insights-index {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .insights-index__header {
    display: grid;
    gap: var(--space-4);
    max-width: 54rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .insights-index__header h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 6rem);
    letter-spacing: -0.05em;
  }

  .insights-index__header > p:last-child,
  .insights-index__empty,
  .insights-list article > p:last-child,
  .insights-index__closing > p {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .insights-index__empty {
    max-width: 42rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-inline-start: 3px solid var(--color-camel);
    background: var(--color-surface);
  }

  .insights-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-ink);
  }

  .insights-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .insights-list article {
    display: grid;
    grid-template-columns: minmax(8rem, 0.3fr) minmax(0, 0.7fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .insights-list__meta {
    margin: 0;
    color: var(--color-bordeaux);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .insights-list h2 {
    grid-column: 2;
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
  }

  .insights-list h2 a {
    color: inherit;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }

  .insights-list article > p:last-child {
    grid-column: 2;
    margin: 0;
  }

  .insights-index__closing {
    display: grid;
    gap: var(--space-4);
    max-width: 54rem;
    margin-top: clamp(4rem, 9vw, 8rem);
    padding-block-start: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-border);
  }

  .insights-index__closing h2,
  .insights-index__closing > p {
    margin: 0;
  }

  .insights-index__closing h2 {
    max-width: 18ch;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }

  .insights-index__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  @media (max-width: 42rem) {
    .insights-list article {
      grid-template-columns: 1fr;
    }

    .insights-list h2,
    .insights-list article > p:last-child {
      grid-column: auto;
    }

    .insights-index__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
