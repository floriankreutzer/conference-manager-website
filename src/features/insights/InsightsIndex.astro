---
import BrandVisual from '@components/marketing/BrandVisual.astro';
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getInsightsJourneyCopy } from '@i18n/insightsJourney';
import { getPublicPageCopy } from '@i18n/publicPages';
import { getPublishedInsightsForLocale } from './content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getPublicPageCopy(locale, 'insights');
const labels = getInsightsJourneyCopy(locale);
const entries = await getPublishedInsightsForLocale(locale);
const dateLocale = locale === 'de' ? 'de-DE' : 'en-GB';
---

<section class="insights-index" aria-labelledby="insights-title">
  <header class="insights-index__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="insights-title">{copy.title}</h1>
    <p>{copy.description}</p>
  </header>

  {
    entries.length === 0 ? (
      <p class="insights-index__empty">{labels.emptyText}</p>
    ) : (
      <ol class="insights-list">
        {entries.map((entry, index) => {
          const articleHref = withBasePath(`/${locale}/insights/${entry.data.routeSlug}/`);
          const date = entry.data.updatedAt ?? entry.data.publishedAt;
          return (
            <li>
              <article class:list={{ 'insights-list__featured': index === 0 }}>
                {index === 0 && (
                  <div class="insights-list__visual">
                    <BrandVisual locale={locale} variant="preparation" priority />
                  </div>
                )}
                <div class="insights-list__copy">
                  <p class="eyebrow">{labels.featuredLabel}</p>
                  <h2>
                    <a href={articleHref}>{entry.data.title}</a>
                  </h2>
                  <p class="insights-list__description">{entry.data.description}</p>
                  {date && (
                    <p class="insights-list__meta">
                      {entry.data.updatedAt ? labels.updatedLabel : labels.publishedLabel}{' '}
                      <time datetime={date.toISOString()}>
                        {date.toLocaleDateString(dateLocale, {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                          timeZone: 'UTC',
                        })}
                      </time>
                    </p>
                  )}
                  <a class="text-link" href={articleHref}>
                    {labels.readArticle}
                    <span aria-hidden="true"> →</span>
                  </a>
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    )
  }
</section>

<style>
  .insights-index {
    padding-block: clamp(3rem, 7vw, 6rem);
    overflow-wrap: anywhere;
  }

  .insights-index__header {
    display: grid;
    gap: var(--space-4);
    max-width: 54rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .insights-index__header h1 {
    max-width: 18ch;
    margin: 0;
    font-size: var(--page-title-size);
    letter-spacing: var(--page-title-tracking);
    line-height: var(--page-title-leading);
  }

  .insights-index__header > p:last-child,
  .insights-index__empty,
  .insights-list__description {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .insights-index__header > p:last-child {
    max-width: 44rem;
    font-size: 1.15rem;
  }

  .insights-index__empty {
    max-width: 42rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-inline-start: 3px solid var(--color-camel);
    background: var(--color-canvas-soft);
  }

  .insights-list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .insights-list article {
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft);
  }

  .insights-list__visual {
    min-width: 0;
    padding: var(--space-3) var(--space-3) 0;
  }

  .insights-list__visual :global(figure),
  .insights-list__visual :global(img) {
    height: 100%;
  }

  .insights-list__visual :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .insights-list__copy {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .insights-list h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.8rem, 3.1vw, 2.8rem);
    line-height: 1.15;
  }

  .insights-list h2 a {
    color: inherit;
    text-decoration: none;
  }

  .insights-list h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }

  .insights-list__meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .insights-list .text-link {
    width: fit-content;
  }

  @media (min-width: 48rem) {
    .insights-list__featured {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }

    .insights-list__visual {
      padding: var(--space-3) 0 var(--space-3) var(--space-3);
    }
  }
</style>
