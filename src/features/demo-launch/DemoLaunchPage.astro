---
import type { Locale } from '@config/locales';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = locale === 'de' ? {
  eyebrow: 'Conference Manager Demo',
  title: 'Demo-Umgebung auswählen',
  lead: 'Dieser statische Absprungpunkt speichert keine Anmeldung, Session, Tenant-ID, Rolle oder Berechtigung.',
  cold: 'Die kostenlosen Demo-Services können nach Inaktivität beim ersten Aufruf zusätzliche Startzeit benötigen.',
  customer: 'Customer Demo',
  customerText: 'Mitarbeiter, Conference Manager, Tenant Admin und die freigegebene Dual-Role-Kombination mit synthetischen Demo-Daten.',
  customerAction: 'Customer Demo starten',
  platform: 'Platform Demo',
  platformText: 'Getrennte Platform-Operator-Erfahrung. Customer-Rollen und Platform-Berechtigungen bleiben isoliert.',
  platformAction: 'Platform Demo starten',
  boundary: 'Sicherheitsgrenze',
  boundaryText: 'Diese Seite ist kein Authentifizierungs-, API-, Persistenz- oder Autorisierungs-Layer. Beide Aktionen navigieren direkt zu den getrennten HTTPS-Demo-Services.',
} : {
  eyebrow: 'Conference Manager Demo',
  title: 'Choose the Demo experience',
  lead: 'This static launch surface stores no login, session, Tenant ID, role or permission.',
  cold: 'The free Demo services can require additional startup time on the first request after inactivity.',
  customer: 'Customer Demo',
  customerText: 'Employee, Conference Manager, Tenant Admin and the approved dual-role combination with synthetic Demo data.',
  customerAction: 'Launch Customer Demo',
  platform: 'Platform Demo',
  platformText: 'Separate Platform Operator experience. Customer roles and Platform authority remain isolated.',
  platformAction: 'Launch Platform Demo',
  boundary: 'Security boundary',
  boundaryText: 'This page is not an authentication, API, persistence or authorization layer. Both actions navigate directly to the separate HTTPS Demo services.',
};
---

<section class="demo-launch" aria-labelledby="demo-launch-title">
  <p class="demo-launch__eyebrow">{copy.eyebrow}</p>
  <h1 id="demo-launch-title">{copy.title}</h1>
  <p class="demo-launch__lead">{copy.lead}</p>
  <p class="demo-launch__notice"><strong>{copy.cold}</strong></p>
  <div class="demo-launch__grid">
    <article>
      <h2>{copy.customer}</h2>
      <p>{copy.customerText}</p>
      <a class="button" href="https://conference-manager-demo.onrender.com">{copy.customerAction}</a>
    </article>
    <article>
      <h2>{copy.platform}</h2>
      <p>{copy.platformText}</p>
      <a class="button" href="https://conference-manager-ops-demo.onrender.com">{copy.platformAction}</a>
    </article>
  </div>
  <section class="demo-launch__boundary" aria-labelledby="demo-boundary-title">
    <h2 id="demo-boundary-title">{copy.boundary}</h2>
    <p>{copy.boundaryText}</p>
  </section>
</section>

<style>
  .demo-launch { padding-block: clamp(4rem, 8vw, 7rem); }
  .demo-launch__eyebrow { font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .demo-launch h1 { max-width: 18ch; font-size: clamp(3rem, 8vw, 6.5rem); margin-block: 1rem; }
  .demo-launch__lead { font-size: clamp(1.1rem, 2vw, 1.4rem); }
  .demo-launch__notice, .demo-launch__boundary { margin-block-start: 2rem; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .demo-launch__grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,20rem),1fr)); gap: 1rem; margin-block-start: 2rem; }
  .demo-launch__grid article { padding: clamp(1.25rem,3vw,2rem); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .demo-launch__grid h2, .demo-launch__boundary h2 { font-size: clamp(1.7rem,3vw,2.5rem); letter-spacing: -.025em; }
</style>
