---
import type { Locale } from '@config/locales';
import { getMeetingExampleCopy } from '@i18n/meetingExample';

interface Props {
  locale: Locale;
  idPrefix?: string;
}

const { locale, idPrefix = 'meeting-example' } = Astro.props;
const copy = getMeetingExampleCopy(locale);
---

<meeting-example class="meeting-example">
  <p class="meeting-example__disclosure">{copy.disclosure}</p>

  <div class="meeting-example__overview">
    <div>
      <p class="meeting-example__eyebrow">{copy.exampleLabel}</p>
      <p class="meeting-example__name">{copy.meetingName}</p>
    </div>
    <dl class="meeting-example__schedule">
      <div>
        <dt>{copy.dateLabel}</dt>
        <dd><time datetime={copy.dateTime}>{copy.date}</time></dd>
      </div>
      <div>
        <dt>{copy.timeLabel}</dt>
        <dd>{copy.time}</dd>
      </div>
    </dl>
  </div>

  <div
    class="meeting-example__controls"
    data-example-controls
    aria-label={copy.controlsLabel}
    hidden
  >
    {
      copy.steps.map((step, index) => (
        <button
          type="button"
          class="meeting-example__tab"
          id={`${idPrefix}-tab-${step.id}`}
          data-example-tab
        >
          <span class="meeting-example__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          {step.tab}
        </button>
      ))
    }
  </div>

  <div class="meeting-example__panels">
    {
      copy.steps.map((step, index) => (
        <section
          class="meeting-example__panel"
          id={`${idPrefix}-panel-${step.id}`}
          aria-labelledby={`${idPrefix}-heading-${step.id}`}
          data-example-panel
        >
          <div class="meeting-example__story">
            <p class="meeting-example__step-name">
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')} / </span>
              {step.tab}
            </p>
            <h3 id={`${idPrefix}-heading-${step.id}`}>{step.title}</h3>
            <p class="meeting-example__introduction">{step.introduction}</p>
            <p class="meeting-example__outcome">{step.outcome}</p>
          </div>

          <div class="meeting-example__details">
            <p class="meeting-example__status">
              <span>{copy.statusLabel}</span>
              <strong>{step.status}</strong>
            </p>
            <dl class="meeting-example__facts">
              <div>
                <dt>{copy.participantsLabel}</dt>
                <dd>
                  {step.previousParticipantCount === undefined ? (
                    <strong class="meeting-example__count">{step.participantCount}</strong>
                  ) : (
                    <div class="meeting-example__change">
                      <span>
                        {copy.previousLabel} <s>{step.previousParticipantCount}</s>
                      </span>
                      <strong>
                        {copy.updatedLabel} {step.participantCount}
                      </strong>
                    </div>
                  )}
                  <p>{step.participantsNote}</p>
                </dd>
              </div>
              <div>
                <dt>{copy.roomLabel}</dt>
                <dd>
                  <strong>{copy.room}</strong>
                  <p>{step.roomNote}</p>
                </dd>
              </div>
              <div>
                <dt>{copy.cateringLabel}</dt>
                <dd>
                  <strong>{step.catering}</strong>
                  <p>{step.cateringNote}</p>
                </dd>
              </div>
              <div>
                <dt>{copy.equipmentLabel}</dt>
                <dd>
                  <strong>{copy.equipment}</strong>
                  <p>{step.equipmentNote}</p>
                </dd>
              </div>
            </dl>
            <p class="meeting-example__responsibility">
              <strong>{copy.responsibilityLabel}</strong>
              <span>{step.responsibility}</span>
            </p>
          </div>
        </section>
      ))
    }
  </div>
</meeting-example>

<script src="./meeting-example.ts"></script>

<style>
  .meeting-example {
    display: block;
    color: var(--color-ink);
    font-family: var(--font-body);
  }

  .meeting-example p,
  .meeting-example dl,
  .meeting-example dd {
    margin: 0;
  }

  .meeting-example__disclosure {
    padding-block-end: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .meeting-example__overview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-camel-soft);
  }

  .meeting-example__eyebrow,
  .meeting-example__schedule dt {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .meeting-example__name {
    padding-block-start: var(--space-1);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .meeting-example__schedule {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: 0.875rem;
  }

  .meeting-example__schedule dd {
    padding-block-start: 0.25rem;
    font-weight: 650;
  }

  .meeting-example__controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1);
    margin-block: var(--space-3);
  }

  .meeting-example__tab {
    display: flex;
    min-block-size: 3.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: var(--space-1);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.3;
    overflow-wrap: anywhere;
    cursor: pointer;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .meeting-example__tab:hover {
    background: var(--color-canvas-soft);
  }

  .meeting-example__tab[aria-selected='true'] {
    border-color: var(--color-bordeaux);
    background: var(--color-bordeaux);
    color: var(--color-on-accent);
  }

  .meeting-example__tab:focus-visible,
  .meeting-example__panel:focus-visible {
    outline: 3px solid var(--color-bordeaux);
    outline-offset: 3px;
  }

  .meeting-example__number {
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .meeting-example__panels {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-3);
  }

  .meeting-example__panel {
    display: grid;
    align-items: start;
    gap: var(--space-5);
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-canvas-soft);
  }

  .meeting-example__controls[hidden],
  .meeting-example__panel[hidden] {
    display: none;
  }

  .meeting-example__step-name {
    color: var(--color-bordeaux);
    font-size: 0.8125rem;
    font-weight: 750;
  }

  .meeting-example__story h3 {
    max-inline-size: 22ch;
    margin-block: var(--space-3);
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    line-height: 1.2;
  }

  .meeting-example__introduction {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .meeting-example__story .meeting-example__outcome {
    margin-block-start: var(--space-4);
    padding-inline-start: var(--space-3);
    border-inline-start: 3px solid var(--color-camel);
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .meeting-example__details {
    min-inline-size: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    overflow-wrap: anywhere;
  }

  .meeting-example__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    padding: var(--space-3);
    border-block-end: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }

  .meeting-example__status > span {
    color: var(--color-text-muted);
  }

  .meeting-example__status strong {
    padding: 0.25rem var(--space-1);
    border-radius: var(--radius-xs);
    background: var(--color-bordeaux-soft);
    color: var(--color-bordeaux-dark);
    font-weight: 650;
  }

  .meeting-example__facts > div {
    display: grid;
    gap: 0.25rem;
    padding: var(--space-3);
  }

  .meeting-example__facts > div + div {
    border-block-start: 1px solid var(--color-border);
  }

  .meeting-example__facts dt {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .meeting-example__facts dd {
    min-inline-size: 0;
    font-size: 0.9375rem;
  }

  .meeting-example__facts strong {
    font-weight: 650;
  }

  .meeting-example__facts dd p {
    padding-block-start: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .meeting-example__count {
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .meeting-example__change {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-3);
    font-variant-numeric: tabular-nums;
  }

  .meeting-example__change > span {
    color: var(--color-text-muted);
  }

  .meeting-example__change > strong {
    color: var(--color-bordeaux);
  }

  .meeting-example__responsibility {
    display: grid;
    gap: 0.25rem;
    padding: var(--space-3);
    border-block-start: 1px solid var(--color-border);
    background: var(--color-camel-soft);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  @media (min-width: 36rem) {
    .meeting-example__tab {
      flex-direction: row;
      gap: var(--space-2);
      font-size: 0.9375rem;
    }

    .meeting-example__facts > div {
      grid-template-columns: minmax(6rem, 0.3fr) minmax(0, 1fr);
      gap: var(--space-3);
    }
  }

  @media (min-width: 56rem) {
    .meeting-example__panel {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meeting-example__tab {
      transition: none;
    }
  }
</style>
