---
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getPricingCopy } from '@i18n/pricing';
import { getPublicPageCopy } from '@i18n/publicPages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pageCopy = getPublicPageCopy(locale, 'pricing');
const story = getPricingCopy(locale);
const demoHref = withBasePath(`/${locale}/book-a-demo/`);
const productHref = withBasePath(`/${locale}/product/`);
---

<article class="pricing-page" aria-labelledby="pricing-title">
  <header class="pricing-page__hero">
    <div class="pricing-page__intro">
      <p class="eyebrow">{pageCopy.eyebrow}</p>
      <h1 id="pricing-title">{pageCopy.title}</h1>
      <p class="pricing-page__lead">{pageCopy.body}</p>
      <div class="pricing-page__actions">
        <a class="pricing-page__text-link" href={productHref}>{story.closing.secondaryCta}</a>
      </div>
    </div>

    <section class="pricing-page__offer" aria-labelledby="pricing-offer-title">
      <p class="eyebrow">{story.offer.eyebrow}</p>
      <h2 id="pricing-offer-title">{story.offer.title}</h2>
      <p>{story.offer.body}</p>
      <p>{story.offer.start}</p>
      <p class="pricing-page__setup-fee"><strong>{story.offer.setupFee}</strong></p>
      <p class="pricing-page__pricing-note">{story.offer.pricingStatus}</p>
    </section>
  </header>

  <section class="pricing-page__journey" aria-labelledby="pricing-journey-title">
    <div class="pricing-page__journey-heading">
      <p class="eyebrow">{story.journey.eyebrow}</p>
      <h2 id="pricing-journey-title">{story.journey.title}</h2>
      <p>{story.journey.body}</p>
    </div>
    <ol class="pricing-page__steps">
      {
        story.sections.map((section, index) => (
          <li>
            <div class="pricing-page__step-heading">
              <span class="pricing-page__step-number" aria-hidden="true">
                {index + 1}
              </span>
              <p class="eyebrow">{section.eyebrow}</p>
              <h3>{section.title}</h3>
            </div>
            <div class="pricing-page__step-copy">
              <p>{section.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="pricing-page__closing" aria-labelledby="pricing-closing-title">
    <p class="eyebrow">{story.closing.eyebrow}</p>
    <h2 id="pricing-closing-title">{story.closing.title}</h2>
    <p>{story.closing.body}</p>
    <a class="button" href={demoHref}>{story.closing.primaryCta}</a>
  </section>
</article>

<style>
  .pricing-page {
    padding-block: clamp(3rem, 7vw, 7rem);
    overflow-wrap: anywhere;
  }

  .pricing-page__hero {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .pricing-page__intro,
  .pricing-page__offer,
  .pricing-page__journey-heading,
  .pricing-page__closing {
    display: grid;
    gap: var(--space-4);
  }

  .pricing-page h1,
  .pricing-page h2,
  .pricing-page h3,
  .pricing-page p {
    margin: 0;
  }

  .pricing-page h1 {
    max-width: 20ch;
    font-size: var(--page-title-size);
    line-height: var(--page-title-leading);
    letter-spacing: var(--page-title-tracking);
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .pricing-page__lead {
    max-width: var(--copy-max);
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }

  .pricing-page__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .pricing-page__text-link {
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .pricing-page__offer {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-block-start: 4px solid var(--color-bordeaux);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .pricing-page__offer h2 {
    max-width: 18ch;
    font-size: clamp(1.8rem, 3vw, 2.75rem);
  }

  .pricing-page__offer > p,
  .pricing-page__step-copy > p,
  .pricing-page__journey-heading > p,
  .pricing-page__closing > p {
    line-height: 1.7;
  }

  .pricing-page__setup-fee {
    color: var(--color-bordeaux);
  }

  .pricing-page__pricing-note {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .pricing-page__journey {
    margin-block-start: clamp(4rem, 9vw, 8rem);
  }

  .pricing-page__journey-heading {
    max-width: 48rem;
    margin-block-end: var(--space-6);
  }

  .pricing-page__journey-heading h2,
  .pricing-page__closing h2 {
    max-width: 25ch;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .pricing-page__journey-heading > p:last-child {
    color: var(--color-text-muted);
  }

  .pricing-page__steps {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pricing-page__steps > li {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 var(--space-4);
    padding-block: var(--space-4);
  }

  .pricing-page__steps > li:not(:last-child)::before {
    position: absolute;
    inset-block: 3.25rem -0.75rem;
    inset-inline-start: 1rem;
    inline-size: 1px;
    background: var(--color-border-strong);
    content: '';
    transform: scaleY(0);
    transform-origin: top;
    animation: pricing-timeline-line-in 420ms ease-out forwards;
  }

  .pricing-page__steps > li:nth-child(2)::before {
    animation-delay: 160ms;
  }

  .pricing-page__step-heading {
    display: contents;
  }

  .pricing-page__step-copy {
    grid-column: 2;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-inline-size: 0;
    padding-block-start: 0.45rem;
    color: var(--color-text-muted);
  }

  .pricing-page__step-number {
    position: relative;
    z-index: 1;
    display: grid;
    grid-row: 1 / span 3;
    align-self: start;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border: 1px solid var(--color-bordeaux);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-bordeaux);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
  }

  .pricing-page__step-heading .eyebrow,
  .pricing-page__step-heading h3 {
    grid-column: 2;
  }

  .pricing-page__step-heading h3 {
    max-inline-size: 20ch;
    font-size: clamp(1.45rem, 2.8vw, 2.15rem);
  }

  @keyframes pricing-timeline-line-in {
    to {
      transform: scaleY(1);
    }
  }

  .pricing-page__closing {
    justify-items: start;
    margin-block-start: var(--space-7);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: var(--radius-md);
    background: var(--color-camel-soft);
  }

  .pricing-page__closing > p {
    max-width: var(--copy-max);
  }

  @media (min-width: 52rem) {
    .pricing-page__hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .pricing-page__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .pricing-page__steps > li {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: var(--space-3);
      padding-block: 0;
      padding-inline-end: 0.5rem;
    }

    .pricing-page__steps > li:not(:last-child)::before {
      inset-block-start: 1rem;
      inset-block-end: auto;
      inset-inline-start: 2rem;
      inline-size: calc(100% + clamp(1.5rem, 3vw, 3rem) - 2rem);
      block-size: 1px;
      transform: scaleX(0);
      transform-origin: left;
      animation-name: pricing-timeline-line-in-horizontal;
    }

    .pricing-page__step-heading {
      display: grid;
      gap: var(--space-3);
    }

    .pricing-page__step-number {
      grid-row: auto;
      inline-size: 2rem;
      block-size: 2rem;
    }

    .pricing-page__step-heading .eyebrow,
    .pricing-page__step-heading h3,
    .pricing-page__step-copy {
      grid-column: auto;
    }

    .pricing-page__step-copy {
      padding-block-start: 0;
    }
  }

  @keyframes pricing-timeline-line-in-horizontal {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-page__steps > li:not(:last-child)::before {
      animation: none;
      transform: none;
    }
  }
</style>
