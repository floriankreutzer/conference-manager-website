---
import BrandLockup from '@components/marketing/BrandLockup.astro';
import { getLoginUrl } from '@config/application';
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getNavigationCopy } from '@i18n/navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const navigation = getNavigationCopy(locale);
const footer = navigation.footer;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <section class="site-footer__brand" aria-labelledby="footer-brand-title">
      <BrandLockup showTagline />
      <h2 id="footer-brand-title" class="visually-hidden">{footer.brandHeading}</h2>
      <p>{footer.brandBody}</p>
    </section>

    <nav class="site-footer__nav" aria-label={footer.productHeading}>
      <h2>{footer.productHeading}</h2>
      <ul>
        {
          footer.productLinks.map((item) => (
            <li>
              <a href={withBasePath(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-footer__nav" aria-label={footer.resourcesHeading}>
      <h2>{footer.resourcesHeading}</h2>
      <ul>
        {
          footer.resourceLinks.map((item) => (
            <li>
              <a href={withBasePath(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__actions">
      <a class="button" href={withBasePath(`/${locale}/book-a-demo/`)}>{footer.demoLabel}</a>
      <a class="site-footer__login" href={getLoginUrl()}
        >{footer.loginLabel}<span aria-hidden="true"> →</span></a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 7vw, 7rem);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-footer__inner {
    width: min(100% - 2rem, var(--content-max));
    margin-inline: auto;
    padding-block: clamp(3rem, 6vw, 5.5rem);
    display: grid;
    grid-template-columns: minmax(18rem, 1.5fr) repeat(2, minmax(10rem, 0.7fr)) minmax(
        10rem,
        0.8fr
      );
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .site-footer__brand p {
    max-width: 39rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .site-footer__nav h2 {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer__nav ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a,
  .site-footer__login {
    color: var(--color-text-muted);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.25em;
  }

  .site-footer__actions {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .site-footer__login {
    font-weight: 700;
  }

  @media (max-width: 64rem) {
    .site-footer__inner {
      grid-template-columns: 1.5fr 1fr 1fr;
    }

    .site-footer__actions {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 42rem) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand,
    .site-footer__actions {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .site-footer__brand,
    .site-footer__actions {
      grid-column: auto;
    }
  }
</style>
