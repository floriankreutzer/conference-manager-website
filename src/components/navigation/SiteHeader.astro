---
import BrandLockup from '@components/marketing/BrandLockup.astro';
import { getLoginUrl } from '@config/application';
import type { Locale } from '@config/locales';
import { withoutBasePath, withBasePath } from '@domain/routing/basePath';
import { getNavigationCopy } from '@i18n/navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const navigation = getNavigationCopy(locale);
const alternateLocale = locale === 'en' ? 'de' : 'en';
const alternateLabel = locale === 'en' ? 'DE' : 'EN';
const relativePath = withoutBasePath(Astro.url.pathname);
const alternatePath = relativePath.replace(/^\/(en|de)(?=\/|$)/, `/${alternateLocale}`);
const currentPath = withBasePath(alternatePath);
---

<header class="site-header">
  <a class="skip-link" href="#main-content">{navigation.skipToContent}</a>
  <div class="site-header__inner">
    <a
      class="brand"
      href={withBasePath(`/${locale}/`)}
      aria-label={`Conference Manager ${locale === 'de' ? 'Startseite' : 'home'}`}
    >
      <BrandLockup compact />
    </a>

    <nav
      class="primary-nav"
      aria-label={locale === 'de' ? 'Hauptnavigation' : 'Primary navigation'}
    >
      <ul class="site-nav">
        {
          navigation.items.map((item) => (
            <li>
              <a href={withBasePath(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-actions">
      <a
        class="language-link"
        href={currentPath}
        hreflang={alternateLocale}
        lang={alternateLocale}
        aria-label={`${navigation.languageLabel}: ${alternateLabel}`}
      >
        {alternateLabel}
      </a>
      <a class="login-link" href={getLoginUrl()}>{navigation.login}</a>
      <a class="button" href={withBasePath(`/${locale}/book-a-demo/`)}>{navigation.bookDemo}</a>
    </div>
  </div>
</header>
