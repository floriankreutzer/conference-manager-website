---
import { getLoginUrl } from '@config/application';
import type { Locale } from '@config/locales';
import { getNavigationCopy } from '@i18n/navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const navigation = getNavigationCopy(locale);
const alternateLocale = locale === 'en' ? 'de' : 'en';
const alternateLabel = locale === 'en' ? 'DE' : 'EN';
const currentPath = Astro.url.pathname.replace(/^\/(en|de)(?=\/|$)/, `/${alternateLocale}`);
---

<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="site-header__inner">
    <a class="brand" href={`/${locale}/`} aria-label={`Conference Manager ${locale === 'de' ? 'Startseite' : 'home'}`}>
      <span class="brand__product">Conference Manager</span>
      <span class="brand__endorsement">by Pavurel</span>
    </a>

    <nav aria-label={locale === 'de' ? 'Hauptnavigation' : 'Primary navigation'}>
      <ul class="site-nav">
        {navigation.items.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-actions">
      <a class="language-link" href={currentPath} hreflang={alternateLocale} lang={alternateLocale} aria-label={`${navigation.languageLabel}: ${alternateLabel}`}>
        {alternateLabel}
      </a>
      <a class="login-link" href={getLoginUrl()}>{navigation.login}</a>
      <a class="button" href={`/${locale}/book-a-demo/`}>{navigation.bookDemo}</a>
    </div>
  </div>
</header>
