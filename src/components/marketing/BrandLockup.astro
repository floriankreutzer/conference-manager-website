---
import pavurelSignet from '../../assets/brand/pavurel-signet.svg?url';

interface Props {
  compact?: boolean;
  showTagline?: boolean;
}

const { compact = false, showTagline = false } = Astro.props;
---

<div class:list={['brand-lockup', { 'brand-lockup--compact': compact }]}>
  <img class="brand-lockup__signet" src={pavurelSignet} alt="" width="512" height="512" />
  <div class="brand-lockup__copy">
    <span class="brand-lockup__product">Conference Manager</span>
    <span class="brand-lockup__endorsement">by Pavurel</span>
    {
      showTagline && (
        <span class="brand-lockup__tagline">Workplace hospitality, thoughtfully managed.</span>
      )
    }
  </div>
</div>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    width: fit-content;
  }

  .brand-lockup__signet {
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
  }

  .brand-lockup__copy {
    display: grid;
    line-height: 1.1;
  }

  .brand-lockup__product {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .brand-lockup__endorsement {
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.73rem;
  }

  .brand-lockup__tagline {
    margin-top: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .brand-lockup--compact {
    gap: 0.65rem;
  }

  .brand-lockup--compact .brand-lockup__signet {
    width: 2.25rem;
    height: 2.25rem;
  }

  @media (max-width: 26rem) {
    .brand-lockup__product {
      font-size: 0.92rem;
    }
  }
</style>
