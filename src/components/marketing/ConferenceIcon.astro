---
import { withBasePath } from '@domain/routing/basePath';
import { pavurelIconAsset } from './conferenceIconAssets';
import type { PavurelIconName, PavurelIconVariant } from './conferenceIconAssets';

interface Props {
  name: PavurelIconName;
  variant?: PavurelIconVariant;
}

const { name, variant = 'light' } = Astro.props;
---

<img
  src={withBasePath(pavurelIconAsset(name, variant))}
  width="24"
  height="24"
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
/>
