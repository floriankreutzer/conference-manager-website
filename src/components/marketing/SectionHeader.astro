---
interface Props {
  eyebrow: string;
  title: string;
  body?: string;
  titleId: string;
  wide?: boolean;
}

const { eyebrow, title, body, titleId, wide = false } = Astro.props;
---

<header class:list={['section-heading', { 'section-heading--wide': wide }]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={titleId}>{title}</h2>
  {body && <p>{body}</p>}
</header>
