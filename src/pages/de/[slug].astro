---
import { publicPageSlugs, type PublicPageSlug } from '@i18n/publicPages';
import PublicPageRoute from '@layouts/PublicPageRoute.astro';

export function getStaticPaths() {
  return publicPageSlugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as PublicPageSlug;
---

<PublicPageRoute locale="de" slug={slug} />
