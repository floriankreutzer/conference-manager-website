---
import DemoRequestForm from '@features/demo-request/DemoRequestForm.astro';
import InsightsIndex from '@features/insights/InsightsIndex.astro';
import MarketingLayout from '@layouts/MarketingLayout.astro';
import PublicInfoPage from '@layouts/PublicInfoPage.astro';
import { getPublicPageCopy, publicPageSlugs, type PublicPageSlug } from '@i18n/publicPages';

export function getStaticPaths() {
  return publicPageSlugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as PublicPageSlug;
const copy = getPublicPageCopy('de', slug);
---

<MarketingLayout
  locale="de"
  title={`${copy.eyebrow} — Conference Manager`}
  description={copy.description}
>
  {
    slug === 'book-a-demo' ? (
      <DemoRequestForm locale="de" />
    ) : slug === 'insights' ? (
      <InsightsIndex locale="de" />
    ) : (
      <PublicInfoPage locale="de" slug={slug} />
    )
  }
</MarketingLayout>
