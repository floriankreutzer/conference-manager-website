  description="Coordinate guests, catering, services and conference requirements in one workplace conference experience while keeping the room-booking systems you already use."
>
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">Conference management for modern workplaces.</p>
    <h1 id="hero-title">Make every workplace conference feel effortless.</h1>
    <p class="hero__copy">
      Manage guests, catering, services and conference requirements in one simple experience — while keeping the room-booking systems your workplace already uses.
    </p>
    <p>
      <a class="button" href="/en/book-a-demo/">Book a demo</a>
      <a href="/en/how-it-works/">See how it works</a>
    </p>
  </section>
</MarketingLayout>
