---
import SiteHeader from '@components/navigation/SiteHeader.astro';
import type { Locale } from '@config/locales';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const enPath = Astro.url.pathname.replace(/^\/de(?=\/|$)/, '/en');
const dePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '/de');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={import.meta.env.PUBLIC_PREVIEW === 'true' ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, canonical)} />
    <link rel="alternate" hreflang="de" href={new URL(dePath, canonical)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, canonical)} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader locale={locale} />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
