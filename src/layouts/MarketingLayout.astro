---
import SiteHeader from '@components/navigation/SiteHeader.astro';
import type { Locale } from '@config/locales';
import { getSeoConfig } from '@config/seo';
import { withoutBasePath, withBasePath } from '@domain/routing/basePath';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const seo = getSeoConfig({
  preview: import.meta.env.PUBLIC_PREVIEW === 'true',
  development: import.meta.env.DEV,
  siteOrigin: import.meta.env.PUBLIC_SITE_ORIGIN,
});
const canonicalBase = seo.siteOrigin ?? Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, canonicalBase);
const relativePath = withoutBasePath(Astro.url.pathname);
const enPath = withBasePath(relativePath.replace(/^\/de(?=\/|$)/, '/en'));
const dePath = withBasePath(relativePath.replace(/^\/en(?=\/|$)/, '/de'));
const socialLocale = locale === 'de' ? 'de_DE' : 'en_US';
const alternateSocialLocale = locale === 'de' ? 'en_US' : 'de_DE';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={seo.indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, canonicalBase)} />
    <link rel="alternate" hreflang="de" href={new URL(dePath, canonicalBase)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, canonicalBase)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Conference Manager" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:locale:alternate" content={alternateSocialLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body>
    <SiteHeader locale={locale} />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
