---
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import { getHomepageCopy } from '@i18n/homepage';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomepageCopy(locale);
const demoHref = withBasePath(`/${locale}/book-a-demo/`);
const howHref = withBasePath(`/${locale}/how-it-works/`);
---

<div class="home-page">
  <section class="hero section" aria-labelledby="hero-title">
    <div class="hero__content">
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <p class="product-lockup"><strong>Conference Manager</strong><span>by Pavurel</span></p>
      <h1 id="hero-title">{copy.hero.title}</h1>
      <p class="hero__copy">{copy.hero.body}</p>
      <div class="cta-row">
        <a class="button" href={demoHref}>{copy.hero.primaryCta}</a>
        <a class="text-link" href={howHref}
          >{copy.hero.secondaryCta}<span aria-hidden="true"> →</span></a
        >
      </div>
    </div>

    <div class="journey" role="img" aria-label={copy.journey.label}>
      <div class="journey__brand" aria-hidden="true"><span></span><span></span><span></span></div>
      <ol>
        <li><span>01</span><strong>{copy.journey.request}</strong></li>
        <li><span>02</span><strong>{copy.journey.booking}</strong></li>
        <li class="journey__wide"><span>03</span><strong>{copy.journey.details}</strong></li>
        <li><span>04</span><strong>{copy.journey.team}</strong></li>
      </ol>
    </div>
  </section>

  <section class="section section--statement" aria-labelledby="problem-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.problem.eyebrow}</p>
      <h2 id="problem-title">{copy.problem.title}</h2>
    </div>
    <div class="statement-copy">
      <p>{copy.problem.body}</p>
      <ul class="fragment-list" aria-label={copy.problem.eyebrow}>
        {copy.problem.fragments.map((fragment) => <li>{fragment}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="product" aria-labelledby="value-title">
    <div class="section-heading section-heading--wide">
      <p class="eyebrow">{copy.value.eyebrow}</p>
      <h2 id="value-title">{copy.value.title}</h2>
      <p>{copy.value.body}</p>
    </div>
    <div class="capability-grid">
      {
        copy.value.cards.map((card, index) => (
          <article class:list={['capability-card', { 'capability-card--accent': index === 0 }]}>
            <span class="card-index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--steps" id="how-it-works" aria-labelledby="steps-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.howItWorks.eyebrow}</p>
      <h2 id="steps-title">{copy.howItWorks.title}</h2>
      <p>{copy.howItWorks.intro}</p>
    </div>
    <ol class="steps">
      {
        copy.howItWorks.steps.map((step) => (
          <li>
            <span class="step-number">{step.number}</span>
            <div>
              <>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section integration-statement" aria-labelledby="booking-title">
    <p class="eyebrow">{copy.roomBooking.eyebrow}</p>
    <h2 id="booking-title">{copy.roomBooking.title}</h2>
    <div class="integration-statement__copy">
      <p>{copy.roomBooking.body}</p>
      <p class="pull-quote">{copy.roomBooking.supporting}</p>
    </div>
  </section>

  <section class="section" id="workplace-teams" aria-labelledby="audience-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.audiences.eyebrow}</p>
      <h2 id="audience-title">{copy.audiences.title}</h2>
    </div>
    <div class="audience-grid">
      <article>
        <span class="audience-mark" aria-hidden="true">E</span><h3>
          {copy.audiences.employee.title}
        </h3><p>{copy.audiences.employee.body}</p>
      </article>
      <article>
        <span class="audience-mark audience-mark--camel" aria-hidden="true">W</span><h3>
          {copy.audiences.workplace.title}
        </h3><p>{copy.audiences.workplace.body}</p>
      </article>
    </div>
  </section>

  <section class="section hospitality" aria-labelledby="hospitality-title">
    <div>
      <p class="eyebrow">{copy.hospitality.eyebrow}</p>
      <h2 id="hospitality-title">{copy.hospitality.title}</h2>
    </div>
    <p>{copy.hospitality.body}</p>
  </section>

  <section class="section ecosystem" id="integrations" aria-labelledby="ecosystem-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.ecosystem.eyebrow}</p>
      <h2 id="ecosystem-title">{copy.ecosystem.title}</h2>
      <p>{copy.ecosystem.body}</p>
    </div>
    <div class="ecosystem__panel">
      <ul>{copy.ecosystem.items.map((item) => <li>{item}</li>)}</ul>
      <p>{copy.ecosystem.microsoft}</p>
    </div>
  </section>

  <section class="section readiness" id="security-trust" aria-labelledby="readiness-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.readiness.eyebrow}</p>
      <h2 id="readiness-title">{copy.readiness.title}</h2>
      <p>{copy.readiness.body}</p>
    </div>
    <ul class="theme-list">{copy.readiness.themes.map((theme) => <li>{theme}</li>)}</ul>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.why.eyebrow}</p>
      <h2 id="why-title">{copy.why.title}</h2>
    </div>
    <div class="why-grid">
      {
        copy.why.cards.map((card) => (
          <article>
            <>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section closing" aria-labelledby="closing-title">
    <p class="eyebrow eyebrow--light">{copy.closing.eyebrow}</p>
    <h2 id="closing-title">{copy.closing.title}</h2>
    <p>{copy.closing.body}</p>
    <div class="cta-row">
      <a class="button button--light" href={demoHref}>{copy.closing.primaryCta}</a>
      <a class="text-link text-link--light" href={howHref}
        >{copy.closing.secondaryCta}<span aria-hidden="true"> →</span></a
      >
    </div>
  </section>
</div>
