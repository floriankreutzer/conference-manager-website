---
import PageIntro from '@components/editorial/PageIntro.astro';
import BrandLockup from '@components/marketing/BrandLockup.astro';
import BrandVisual from '@components/marketing/BrandVisual.astro';
import ConferenceIcon from '@components/marketing/ConferenceIcon.astro';
import SectionHeader from '@components/marketing/SectionHeader.astro';
import type { Locale } from '@config/locales';
import { withBasePath } from '@domain/routing/basePath';
import MeetingExample from '@features/meeting-example/MeetingExample.astro';
import { getHomepageCopy } from '@i18n/homepage';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomepageCopy(locale);
const demoHref = withBasePath(`/${locale}/book-a-demo/`);
const howHref = withBasePath(`/${locale}/how-it-works/`);
const productHref = withBasePath(`/${locale}/product/`);
const integrationsHref = withBasePath(`/${locale}/integrations/`);
const audiencesHref = withBasePath(`/${locale}/workplace-teams/`);
const pricingHref = withBasePath(`/${locale}/pricing/`);
const trustHref = withBasePath(`/${locale}/security-trust/`);
const icons = [
  'request',
  'participants',
  'room-equipment',
  'catering',
  'changes',
  'coordination',
] as const;
---

<div class="home-page">
  <section class="hero section home-hero" aria-labelledby="hero-title">
    <div class="hero__content">
      <PageIntro
        eyebrow={copy.hero.eyebrow}
        titleId="hero-title"
        lead={copy.hero.body}
        tone="on-image"
      >
        <Fragment slot="title">
          <span>{copy.hero.title}</span>
          <span class="hero__outcome">{copy.hero.outcome}</span>
        </Fragment>
        <div class="cta-row">
          <a class="button" href="#how-it-works">{copy.hero.action}</a>
        </div>
      </PageIntro>
    </div>
    <div class="hero__visual home-hero__media">
      <BrandVisual locale={locale} variant="meeting" priority />
      <aside class="hero-preview" aria-label={copy.heroPreview.label}>
        <div class="hero-preview__header">
          <div>
            <p class="hero-preview__label">{copy.heroPreview.label}</p>
            <p class="hero-preview__title">{copy.heroPreview.title}</p>
          </div>
          <span class="hero-preview__status">{copy.heroPreview.status}</span>
        </div>
        <ul class="hero-preview__items">
          {
            copy.heroPreview.items.map((item, index) => (
              <li>
                <ConferenceIcon
                  name={index === 0 ? 'participants' : index === 1 ? 'catering' : 'room-equipment'}
                />
                <span>
                  <small>{item.label}</small>
                  <strong>{item.value}</strong>
                </span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="request-overview" id="product" aria-labelledby="overview-label">
    <p id="overview-label">{copy.overview.label}</p>
    <ul class="request-overview__items">
      {
        copy.overview.items.map((item, index) => (
          <li>
            <ConferenceIcon name={icons[index] ?? 'request'} />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <p class="section-link">
      <a href={productHref}>{copy.overview.detailLink}<span aria-hidden="true"> →</span></a>
    </p>
  </section>

  <section class="section problem-section" aria-labelledby="problem-title">
    <SectionHeader
      eyebrow={copy.problem.eyebrow}
      title={copy.problem.title}
      body={copy.problem.body}
      titleId="problem-title"
      wide
    />
    <div class="problem-grid">
      {
        copy.problem.cards.map((card, index) => (
          <article class="problem-card">
            <span class="problem-card__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section workflow-section" id="how-it-works" aria-labelledby="workflow-title">
    <SectionHeader
      eyebrow={copy.howItWorks.eyebrow}
      title={copy.howItWorks.title}
      body={copy.howItWorks.body}
      titleId="workflow-title"
      wide
    />
    <MeetingExample locale={locale} />
    <p class="section-link">
      <a href={howHref}>{copy.howItWorks.detailLink}<span aria-hidden="true"> →</span></a>
    </p>
  </section>

  <section
    class="section integration-section"
    id="integrations"
    aria-labelledby="integration-title"
  >
    <SectionHeader
      eyebrow={copy.roomBooking.eyebrow}
      title={copy.roomBooking.title}
      body={copy.roomBooking.body}
      titleId="integration-title"
      wide
    />
    <div class="integration-map">
      <div class="integration-map__hub">
        <BrandLockup />
        <p>{copy.roomBooking.supporting}</p>
      </div>
      <div class="integration-map__nodes">
        {
          copy.roomBooking.nodes.map((node, index) => (
            <article
              class:list={['integration-node', { 'integration-node--optional': index === 3 }]}
            >
              <p class="integration-node__label">{node.label}</p>
              <h3>{node.title}</h3>
              <p>{node.body}</p>
            </article>
          ))
        }
      </div>
    </div>
    <div class="integration-replacement">
      <ConferenceIcon name="catering" />
      <div>
        <h3>{copy.roomBooking.replacement.title}</h3>
        <p>{copy.roomBooking.replacement.body}</p>
      </div>
    </div>
    <p class="section-link">
      <a href={integrationsHref}>{copy.roomBooking.detailLink}<span aria-hidden="true"> →</span></a>
    </p>
  </section>

  <section class="section audience-section" id="workplace-teams" aria-labelledby="audience-title">
    <SectionHeader
      eyebrow={copy.audiences.eyebrow}
      title={copy.audiences.title}
      body={copy.audiences.body}
      titleId="audience-title"
      wide
    />
    <div class="audience-grid">
      {
        copy.audiences.cards.map((card, index) => (
          <article>
            <span class="audience-label" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>
    <p class="section-link">
      <a href={audiencesHref}>{copy.audiences.detailLink}<span aria-hidden="true"> →</span></a>
    </p>
  </section>

  <section class="section pilot-section" id="pilot" aria-labelledby="pilot-title">
    <div class="pilot-section__content">
      <SectionHeader
        eyebrow={copy.pilot.eyebrow}
        title={copy.pilot.title}
        body={copy.pilot.body}
        titleId="pilot-title"
      />
      <div class="cta-row">
        <a class="text-link" href={pricingHref}
          >{copy.pilot.detailLink}<span aria-hidden="true"> →</span></a
        >
      </div>
    </div>
    <div class="pilot-section__visual">
      <BrandVisual locale={locale} variant="preparation" />
    </div>
  </section>

  <aside class="readiness-strip" id="security-trust">
    <p>{copy.readiness.body}</p>
    <a class="text-link" href={trustHref}>{copy.readiness.link}<span aria-hidden="true"> →</span></a
    >
  </aside>

  <section class="section closing" aria-labelledby="closing-title">
    <div class="closing__content">
      <p class="eyebrow eyebrow--light">{copy.closing.eyebrow}</p>
      <h2 id="closing-title">{copy.closing.title}</h2>
      <p class="closing__copy">{copy.closing.body}</p>
      <a class="button button--light" href={demoHref}>{copy.closing.primaryCta}</a>
    </div>
  </section>
</div>
