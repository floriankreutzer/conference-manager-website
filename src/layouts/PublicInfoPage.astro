---
import type { Locale } from '@config/locales';
import type { PublicPageSlug } from '@i18n/publicPages';
import { getPublicPageCopy } from '@i18n/publicPages';

interface Props {
  locale: Locale;
  slug: PublicPageSlug;
}

const { locale, slug } = Astro.props;
const copy = getPublicPageCopy(locale, slug);
---

<section class="info-page" aria-labelledby="info-title">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1 id="info-title">{copy.title}</h1>
  <p class="info-page__lead">{copy.body}</p>
  {
    copy.note && (
      <aside class="info-page__note" aria-label={locale === 'de' ? 'Hinweis' : 'Note'}>
        {copy.note}
      </aside>
    )
  }
</section>
