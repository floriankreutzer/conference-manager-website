---
import PageIntro from '@components/editorial/PageIntro.astro';
import type { Locale } from '@config/locales';
import type { PublicPageSlug } from '@i18n/publicPages';
import { getPublicPageCopy } from '@i18n/publicPages';

interface Props {
  locale: Locale;
  slug: PublicPageSlug;
}

const { locale, slug } = Astro.props;
const copy = getPublicPageCopy(locale, slug);
---

<section class="info-page page-hero" aria-labelledby="info-title">
  <PageIntro eyebrow={copy.eyebrow} title={copy.title} titleId="info-title" lead={copy.body} />
  {
    copy.note && (
      <aside class="info-page__note" aria-label={locale === 'de' ? 'Hinweis' : 'Note'}>
        {copy.note}
      </aside>
    )
  }
</section>
