{
  "name": "conference-manager-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{astro,ts}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"functions/**/*.{js,json}\" \"*.{js,mjs,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"functions/**/*.{js,json}\" \"*.{js,mjs,json,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/check-build-budgets.mjs"
  },
  "dependencies": {
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
